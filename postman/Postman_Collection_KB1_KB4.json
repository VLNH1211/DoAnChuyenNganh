  "item": [
    {
      "name": "00. Lấy JWT Token (Đăng nhập)",
      "item": [
        {
          "name": "Login V2 - admin (Role: Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login Admin thành công - Status 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.token).to.not.be.empty;",
                  "    pm.collectionVariables.set(\"token_admin\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl_V2}}/api/auth/login", "host": ["{{baseUrl_V2}}"], "path": ["api", "auth", "login"] }
          }
        },
